# Clerk. Both keys come from the same Clerk instance the mobile app and the API
# use — one instance, three clients (decisions.md D-01).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Where the dashboard sends the user when Clerk needs them signed in, and where
# it puts them afterwards. Clerk reads these itself; they are not imported.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Note: a new sign-up goes to /welcome first whatever this says — the signup
# page sets `forceRedirectUrl` so the caregiver role is granted before the
# dashboard is ever asked for. /welcome forwards to the dashboard itself.

# Where apps/api is reachable. `task dev:api` serves it on 8080; set this to the
# deployed origin for a build. The browser calls this directly, so the API must
# list this app's origin in CLERK_AUTHORIZED_PARTIES and allow it through CORS.
NEXT_PUBLIC_API_URL=http://localhost:8080
