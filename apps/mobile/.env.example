EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where apps/api is reachable from the device. Left blank in development, the
# app derives it from the Expo packager host — set it for a build, or to point
# at a deployed API.
EXPO_PUBLIC_API_URL=

# Which repository publishes the APKs the app updates itself from, as
# `owner/name`. Left blank it uses the repository Smaran ships from — set it to
# point a fork or a staging channel somewhere else.
EXPO_PUBLIC_UPDATE_REPO=

# Development only. Forces the update card into one state so it can be looked
# at without publishing a release: offered, required, unavailable, corrupt or
# refused. Ignored entirely in a release build. Leave blank normally.
EXPO_PUBLIC_UPDATE_PREVIEW=

# How release APKs are signed. The keystore itself lives in `credentials/` and
# is never committed; these are the passwords for it, read by the
# `with-release-signing` plugin at prebuild time. Leave them blank and a release
# build falls back to the debug key — fine for working on the app, never for a
# build anybody is meant to install, because no installed Smaran can accept an
# update signed with a different key.
ANDROID_KEYSTORE_FILE=my-upload-key.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
