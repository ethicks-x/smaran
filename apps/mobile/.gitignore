# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Full-resolution landing art. Nothing requires these, so they never reach a
# bundle — they are the lossless originals the shipped WebP was encoded from,
# kept on disk and out of the repo's history.
assets/images/landing/_masters/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# signing keystores — never committed
/credentials
