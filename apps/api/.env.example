## Uvicorn settings
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8080
UVICORN_RELOAD=true

## Database settings
DATABASE_URL=postgresql+psycopg://postgres:your_password@db.your-project.supabase.co:5432/postgres 
#DATABASE_URL=postgresql+psycopg://postgres.your-project:[Your-Password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# DB_ECHO=false

# S3-compatible Storage Settings
S3_CERT_BUCKET=my-cert-bucket
S3_CERT_KEY=prod-ca-2021.crt

# Optional S3 Settings (Leave blank/omit if using AWS IAM Roles/Instance Profiles)
# For Cloudflare R2, MinIO, or Supabase Storage, supply the custom endpoint:
S3_ENDPOINT_URL=your_endpoint_url
S3_REGION_NAME=auto
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key

## Clerk settings
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
# Optional. Clerk's PEM public key, from the Clerk dashboard. Set it to verify session
# tokens without a network call to Clerk on every request.
# CLERK_JWT_KEY=
# Optional. Comma-separated origins allowed to present a token (the azp claim).
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000,smaran://

## Roles
# Roles are granted in the `roles` table, never in Clerk. This is only the value a
# caregiver's row is expected to hold in `roles.role`.
CAREGIVER_ROLE=caregiver

# Optional overrides
# APP_ENV=development
