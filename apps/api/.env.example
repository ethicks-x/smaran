## Uvicorn settings
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8080
UVICORN_RELOAD=true

## Database settings
DATABASE_URL=postgresql+psycopg://postgres:your_password@db.your-project.supabase.co:5432/postgres 
#DATABASE_URL=postgresql+psycopg://postgres.your-project:[Your-Password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# DB_ECHO=false

## S3-compatible storage
# One set of credentials serves both buckets below. For Cloudflare R2, MinIO or Supabase
# Storage, supply the custom endpoint; on AWS with an IAM role or instance profile, leave
# the key pair blank and boto3 will pick the role up.
# Alembic owns the schema — run `task db:migrate`. Set this true only for a throwaway
# database: it creates missing tables from the models on startup but never a missing
# column, so it leaves a schema that looks built and is not.
DB_AUTO_CREATE=false

# S3-compatible Storage Settings
S3_CERT_BUCKET=my-cert-bucket
S3_CERT_KEY=prod-ca-2021.crt

# Optional S3 Settings (Leave blank/omit if using AWS IAM Roles/Instance Profiles)
# For Cloudflare R2, MinIO, or Supabase Storage, supply the custom endpoint:
S3_ENDPOINT_URL=your_endpoint_url
S3_REGION_NAME=auto
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key

## Memory media
# The bucket memory photos, audio and stories live in. The dashboard PUTs each file
# straight at it with a presigned URL and the phone GETs it back the same way, so the
# bytes never pass through this API — only the `memory_assets` row describing them does.
S3_MEMORIES_BUCKET=smaran-memories
# Key prefix every memory object is written under, inside that bucket.
S3_MEMORIES_PREFIX=memories/
# Optional. Set this only if the bucket is fronted by a CDN or is publicly readable.
# Leave it unset and the API signs a short-lived GET per object instead, which is the
# right default here: these are photographs of a named person living with dementia, and
# a public object URL is an unauthenticated one that never expires.
# S3_MEMORIES_PUBLIC_BASE_URL=https://memories.example.org
# How long a presigned upload or download URL stays valid. Long enough for a slow
# connection to finish a photo, short enough that a copied URL is stale before it is read.
# S3_PRESIGN_EXPIRY_SECONDS=3600
# Largest single memory upload accepted, in bytes. Defaults to 25 MiB.
# S3_MAX_UPLOAD_BYTES=26214400

## Clerk settings
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
# Optional. Clerk's PEM public key, from the Clerk dashboard. Set it to verify session
# tokens without a network call to Clerk on every request.
# CLERK_JWT_KEY=
# Optional. Comma-separated origins allowed to present a token (the azp claim).
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000,smaran://

## CORS
# Comma-separated browser origins allowed to call this API. The caregiver dashboard
# calls it directly from the browser, so its origin must be listed here as well as in
# CLERK_AUTHORIZED_PARTIES above. Defaults to http://localhost:3000.
# CORS_ALLOW_ORIGINS=http://localhost:3000

## Roles
# Roles are granted in the `roles` table, never in Clerk. These are only the values a
# caregiver's and a patient's row are expected to hold in `roles.role`. A new account
# self-enrols into one of them once, from the client that created it: the dashboard asks
# for the caregiver role, the phone asks for the patient role.
CAREGIVER_ROLE=caregiver
PATIENT_ROLE=patient

## Google Gemini AI
# Google Gemini API key used for generating AI patient insights from historical data.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional overrides
# APP_ENV=development
