{
  "name": "cgamp",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "apps/packages/*"
  ],
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^17.4.1"
  },
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx,js,jsx,json}": [
      "bunx biome check --write --config-path apps/web"
    ],
    "apps/mobile/**/*.{ts,tsx,js,jsx,json,css}": [
      "bun run --cwd apps/mobile lint:fix",
      "bun run --cwd apps/mobile format"
    ],
    "apps/api/**/*.py": [
      "uv run --project apps/api ruff check --fix --force-exclude",
      "uv run --project apps/api ruff format --force-exclude"
    ]
  },
  "dependencies": {
    "@clerk/nextjs": "^7.8.3"
  }
}
